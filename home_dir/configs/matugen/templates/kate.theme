{
    "metadata" : {
        "name" : "Matugen",
        "revision" : 1,
        "license": "SPDX-License-Identifier: MIT"
    },
    "text-styles": {
        "Normal" : {"text-color" : "{{colors.on_surface.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Keyword" : {"text-color" : "{{colors.primary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}", "bold" : true},
        "Function" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Variable" : {"text-color" : "{{colors.on_surface.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "ControlFlow" : {"text-color" : "{{colors.primary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}", "bold" : true},
        "Operator" : {"text-color" : "{{colors.on_surface_variant.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "BuiltIn" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Extension" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}", "bold" : true},
        "Preprocessor" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Attribute" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Char" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "SpecialChar" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "String" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "VerbatimString" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "SpecialString" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Import" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "DataType" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "DecVal" : {"text-color" : "{{colors.primary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "BaseN" : {"text-color" : "{{colors.primary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Float" : {"text-color" : "{{colors.primary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "Constant" : {"text-color" : "{{colors.primary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}", "bold" : true},
        "Comment" : {"text-color" : "{{colors.outline.default.hex}}", "selected-text-color" : "{{colors.outline.default.hex}}"},
        "Documentation" : {"text-color" : "{{colors.outline.default.hex}}", "selected-text-color" : "{{colors.outline.default.hex}}"},
        "Annotation" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.on_primary_container.default.hex}}"},
        "CommentVar" : {"text-color" : "{{colors.outline.default.hex}}", "selected-text-color" : "{{colors.outline.default.hex}}"},
        "RegionMarker" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.secondary.default.hex}}", "background-color" : "{{colors.secondary_container.default.hex}}"},
        "Information" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.secondary.default.hex}}"},
        "Warning" : {"text-color" : "{{colors.tertiary.default.hex}}", "selected-text-color" : "{{colors.tertiary.default.hex}}"},
        "Alert" : {"text-color" : "{{colors.error.default.hex}}", "selected-text-color" : "{{colors.error.default.hex}}", "background-color" : "{{colors.error_container.default.hex}}", "bold" : true},
        "Error" : {"text-color" : "{{colors.error.default.hex}}", "selected-text-color" : "{{colors.error.default.hex}}", "underline" : true},
        "Others" : {"text-color" : "{{colors.secondary.default.hex}}", "selected-text-color" : "{{colors.secondary.default.hex}}"}
    },
    "editor-colors": {
        "BackgroundColor" : "{{colors.surface.default.hex}}",
        "CodeFolding" : "{{colors.secondary_container.default.hex}}",
        "BracketMatching" : "{{colors.primary_container.default.hex}}",
        "CurrentLine" : "{{colors.surface_container.default.hex}}",
        "IconBorder" : "{{colors.surface_container_low.default.hex}}",
        "IndentationLine" : "{{colors.outline_variant.default.hex}}",
        "LineNumbers" : "{{colors.outline.default.hex}}",
        "CurrentLineNumber" : "{{colors.on_surface.default.hex}}",
        "MarkBookmark" : "{{colors.primary.default.hex}}",
        "MarkBreakpointActive" : "{{colors.error.default.hex}}",
        "MarkBreakpointReached" : "{{colors.tertiary.default.hex}}",
        "MarkBreakpointDisabled" : "{{colors.outline.default.hex}}",
        "MarkExecution" : "{{colors.surface_container_high.default.hex}}",
        "MarkWarning" : "{{colors.tertiary.default.hex}}",
        "MarkError" : "{{colors.error.default.hex}}",
        "ModifiedLines" : "{{colors.tertiary.default.hex}}",
        "ReplaceHighlight" : "{{colors.secondary_container.default.hex}}",
        "SavedLines" : "{{colors.secondary.default.hex}}",
        "SearchHighlight" : "{{colors.tertiary_container.default.hex}}",
        "TextSelection" : "{{colors.primary_container.default.hex}}",
        "Separator" : "{{colors.outline_variant.default.hex}}",
        "SpellChecking" : "{{colors.error.default.hex}}",
        "TabMarker" : "{{colors.outline_variant.default.hex}}",
        "TemplateBackground" : "{{colors.surface_container_high.default.hex}}",
        "TemplatePlaceholder" : "{{colors.primary_container.default.hex}}",
        "TemplateFocusedPlaceholder" : "{{colors.primary_container.default.hex}}",
        "TemplateReadOnlyPlaceholder" : "{{colors.error_container.default.hex}}",
        "WordWrapMarker" : "{{colors.outline_variant.default.hex}}"
    }
}
